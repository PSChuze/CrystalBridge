# Copy to .env and edit. Every value here is optional; an EMPTY value always
# means "use the built-in default", never "empty string as the value".
# Credentials default to obvious placeholders: change them before anything but
# a LAN can reach this host.

# ---------------------------------------------------------------- addresses

# The address FFXI clients reach this host on. Written into LSB's per-zone
# zone_settings.zoneip (the map server address the character-select handoff
# advertises) and handed to the client as the search-server address, so it must
# be one the CLIENT can route to: your LAN IP, VPN IP, or public IP.
# Default when empty: 127.0.0.1 (a client on this same machine only).
LSB_ADVERTISE_IP=

# --------------------------------------------------------------- database

# MariaDB credentials shared by LSB's servers and the bridge's import endpoint.
# Defaults: xidb / xiadmin / change-me / change-me-root.
LSB_DB_NAME=
LSB_DB_USER=
LSB_DB_PASSWORD=
LSB_DB_ROOT_PASSWORD=

# ------------------------------------------------------------- LSB settings

# The client version LSB expects, as the client's patch.ver spells it
# (yyyymmdd_r). Default: 30260703_1. Set it to what YOUR client reports; with
# LSB_VER_LOCK at 1 or 2 a mismatch is refused with FFXI-3331 on the client.
LSB_CLIENT_VER=

# LSB's login.VER_LOCK. 0 = accept every client build (the default here);
# 1 = exact match on LSB_CLIENT_VER; 2 = the client must be at least
# LSB_CLIENT_VER (LSB's own default, compared on the first six characters).
LSB_VER_LOCK=

# The world name shown on the world-list and character-select screens.
# Max 15 characters. Default: Nameless (LSB's own).
LSB_SERVER_NAME=

# ------------------------------------------------------------------ bridge

# The bridge's shared LSB account: its startup smoke test, and the fallback
# when FFXI_REQUIRE_SIGNED_IN=0. Created on first start if LSB lacks it.
# Defaults: poltest / change-me.
LSB_ACCOUNT=
LSB_PASSWORD=

# Seed for the per-member LSB passwords (one LSB account per PlayOnline
# member, password derived from this seed and never stored). Set it once and
# keep it: changing it changes every member's LSB password. Default: change-me.
FFXI_ACCT_SECRET=

# 1 (default): refuse an FFXI launch that cannot be attributed to a signed-in
# Viewer session, rather than guess. 0: fall back to the shared LSB account,
# which means every member sees the same character list.
FFXI_REQUIRE_SIGNED_IN=

# Diagnostics written to the bridge-logs volume. 1 (default) or 0.
# FFXI_PKT_DUMP: every lobby packet, raw. FFXI_WORLD_CAPTURE: the world UDP
# flows, one JSON line per datagram, bounded per flow and by file count.
FFXI_PKT_DUMP=
FFXI_WORLD_CAPTURE=

# Port of the character-import endpoint inside the bridge (POST /import).
# Default: 54004, which is also the published host port. 0 disables it.
BRIDGE_IMPORT_PORT=

# -------------------------------------- optional second world (Test Client)

# Route clients reporting this six-character build to a second LSB world
# (docker-compose.lsb-test.yml). Empty (default): off, one world for everyone.
# 201108 is the FFXI Test Server client.
LSB_ALT_VER=
# Where that world's login server is, as seen from the bridge container.
# Default: host.docker.internal (the Docker host); a LAN IP also works.
LSB_ALT_HOST=
# Its view / data / auth ports on that host. Defaults: 55001 / 55230 / 55231.
LSB_ALT_VIEW_PORT=
LSB_ALT_DATA_PORT=
LSB_ALT_AUTH_PORT=

# Settings read only by docker-compose.lsb-test.yml.
# Defaults: xidb / xiadmin / change-me / change-me-root / 20110811_A / Test / 55230.
LSBTEST_DB_NAME=
LSBTEST_DB_USER=
LSBTEST_DB_PASSWORD=
LSBTEST_DB_ROOT_PASSWORD=
LSBTEST_CLIENT_VER=
LSBTEST_SERVER_NAME=
LSBTEST_MAP_PORT=
